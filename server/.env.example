# Copy to server/.env for local development only.
# In production, secrets come from deploy/.env (see DEPLOY.md).
PORT=5000
NODE_ENV=development
JWT_SECRET=            # generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DB_PATH=./db/smm_uper.db
ADMIN_EMAIL=admin@smmuper.com
ADMIN_PASSWORD=       # choose your own; used by `npm run seed`
# SEED_DEMO=1         # dev only: creates demo/staff users and sample providers
